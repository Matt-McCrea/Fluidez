{
  "id": "sc-u35-b",
  "unit": "u35",
  "title": "En la recepción",
  "spare": false,
  "brief": "You're at the clinic desk, asking for an appointment for your friend Hernando. The receptionist is a stranger, so use usted. Describe how he feels, ask politely and find out what rules apply.",
  "turns": [
    {
      "id": "t1",
      "npc": "Buenas tardes. ¿Para quién es la cita?",
      "npcEn": "Good afternoon. Who is the appointment for?",
      "intent": "Say it's for your friend Hernando and that he feels very bad.",
      "accept": [
        "Es para mi amigo Hernando. Se siente muy mal.",
        "La cita es para un amigo, Hernando. Se siente fatal.",
        "Es para Hernando. Se siente mal desde ayer."
      ],
      "require": [
        {
          "type": "regex",
          "pattern": "\\bpara\\b",
          "flags": "i",
          "label": "it is for: es para"
        },
        {
          "type": "regex",
          "pattern": "\\bse siente\\b",
          "flags": "i",
          "label": "he feels: se siente"
        }
      ],
      "focus": "p:sentirse-mal",
      "next": "t2"
    },
    {
      "id": "t2",
      "npc": "¿Qué síntomas tiene?",
      "npcEn": "What symptoms does he have?",
      "intent": "Describe a symptom: he is very tired, or he has a headache.",
      "accept": [
        "Está muy cansado y tiene dolor de cabeza.",
        "Se cayó y tiene mucho dolor en el pecho.",
        "Se siente mareado y no puede caminar bien."
      ],
      "require": [
        {
          "type": "anyVerbInTense",
          "tense": "presente",
          "label": "say how he is now (present)"
        }
      ],
      "focus": "p:sentirse-mal",
      "next": "t3"
    },
    {
      "id": "t3",
      "npc": "El doctor lo va a ver ahora. Una sola persona puede pasar con él.",
      "npcEn": "The doctor will see him now. Only one person can go in with him.",
      "intent": "Politely ask if she minds if you go in with him.",
      "accept": [
        "¿Le importa si entro yo?",
        "Perdón, ¿le importa si paso yo con él?",
        "¿Le importa si lo acompaño yo?"
      ],
      "require": [
        {
          "type": "regex",
          "pattern": "\\bimporta si\\b",
          "flags": "i",
          "label": "do you mind if: le importa si"
        },
        {
          "type": "avoidsAny",
          "words": [
            "te importa"
          ],
          "label": "use usted: le importa"
        }
      ],
      "focus": "p:te-importa-si",
      "next": "t4"
    },
    {
      "id": "t4",
      "npc": "Está bien. ¿Tiene la tarjeta de la EPS?",
      "npcEn": "That's fine. Do you have the EPS card?",
      "intent": "Say you don't have it and ask if you can pay in cash.",
      "accept": [
        "No la tengo. ¿Se puede pagar en efectivo?",
        "No, la dejó en su casa. ¿Se puede pagar en la caja?",
        "No la traje. ¿Se puede pagar en efectivo?"
      ],
      "require": [
        {
          "type": "regex",
          "pattern": "\\bse puede\\b",
          "flags": "i",
          "label": "can one: se puede"
        },
        {
          "type": "question",
          "label": "ask a question"
        }
      ],
      "focus": "p:se-puede-me-dejas",
      "next": "t5"
    },
    {
      "id": "t5",
      "npc": "Sí, en la caja. Y mañana tiene que volver a las ocho.",
      "npcEn": "Yes, at the cash desk. And he has to come back tomorrow at eight.",
      "intent": "Ask whether he must bring anything.",
      "accept": [
        "¿Debe traer algo?",
        "¿Él debe traer algo más?",
        "Perfecto. ¿Hernando debe traer los medicamentos?"
      ],
      "require": [
        {
          "type": "verbFormAny",
          "inf": "deber",
          "tense": "presente",
          "label": "must he: debe"
        },
        {
          "type": "question",
          "label": "ask a question"
        }
      ],
      "focus": "g:deber-modal",
      "next": "t6"
    },
    {
      "id": "t6",
      "npc": "Nada más la tarjeta y su cédula.",
      "npcEn": "Only the card and his ID.",
      "intent": "Thank her and say see you tomorrow.",
      "accept": [
        "Muchas gracias por todo. Hasta mañana.",
        "Gracias. Hasta mañana.",
        "Muy amable, gracias. Hasta mañana."
      ],
      "require": [
        {
          "type": "regex",
          "pattern": "\\bgracias\\b",
          "flags": "i",
          "label": "say thanks"
        }
      ],
      "focus": "p:se-puede-me-dejas",
      "next": null
    }
  ],
