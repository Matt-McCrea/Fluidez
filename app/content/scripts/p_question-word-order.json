  "hook": {
    "line": "Don Hernando asks about everyone in the café. To ask about another person in Spanish, the person goes after the verb, and does disappears.",
    "es": "¿Dónde vive Vale? ¿Cuándo llega el jefe?",
    "en": "Where does Vale live? When does the boss arrive?"
  },
  "examples": [
    {
      "es": "¿Dónde vive Vale?",
      "en": "Where does Vale live?"
    },
    {
      "es": "¿Cuándo llega el jefe?",
      "en": "When does the boss arrive?"
    },
    {
      "es": "¿Qué estudia Mariana?",
      "en": "What does Mariana study?"
    },
    {
      "es": "¿Dónde trabaja el señor Ruiz?",
      "en": "Where does Mr Ruiz work?"
    },
    {
      "es": "¿Cómo está don Hernando?",
      "en": "How is Don Hernando?"
    },
    {
      "es": "¿Vale vive en Chapinero?",
      "en": "Does Vale live in Chapinero?"
