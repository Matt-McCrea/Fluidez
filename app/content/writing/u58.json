  {
    "id": "w-u58-02",
    "unit": "u58",
    "prompt": "Reply to a guest at the café, someone you've never met, who asks what the place is like. You're writing in the guestbook and want to describe the building's first impression and what the windows look out on. Address the guest as someone your age.",
    "minWords": 150,
    "maxWords": 250,
    "constraints": [
      {
        "type": "regex",
        "pattern": "lo primero que",
        "label": "anchor your description with lo primero que…"
      },
      {
        "type": "regex",
        "pattern": "\\b(da|dan|daba|daban) (a|al)\\b",
        "label": "say what a window or room faces with dar a / dar al"
