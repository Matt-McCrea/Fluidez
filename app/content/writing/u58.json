  {
    "id": "w-u58-03",
    "unit": "u58",
    "prompt": "Write a message to Mariana, who is a journalist and a friend, explaining the state of the café now and what it's like to run. You need to say what is made of what, who is working where, and what is about to happen. Use a casual register.",
    "minWords": 150,
    "maxWords": 250,
    "constraints": [
      {
        "type": "regex",
        "pattern": "\\b(es|son|era|eran|fue|fueron) de (madera|piedra|cerámica|barro|hierro|metal|vidrio|cobre|roble|comino|pino|bronce|oro|plata|adobe|ladrillo|mármol|cuero|tela|lana|algodón|plástico|papel|cemento|acero)\\b",
        "label": "say what something is made of with ser de"
      },
      {
        "type": "regex",
        "pattern": "\\b(está|estoy|están|estás|estamos|estaba|estaban|estuvo|estuve) (de|para|por) \\w+",
        "label": "use estar de / para / por (está de mesero, está para llover, está por verse)"
      },
