        "type": "avoidsAny",
        "words": [
          "yo gusto",
          "gusto el",
          "gusto la",
          "gusto los",
          "gusto las"
        ],
        "label": "gustar works like \"is pleasing to me\": me gusta, not yo gusto"
      }
