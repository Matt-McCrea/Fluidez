    "roles": { "a": "You", "b": "Shop assistant" },
    "lines": [
      { "who": "a", "ru": "Здра'вствуйте! У вас есть хлеб?", "en": "Hello! Do you have bread?" },
      { "who": "b", "ru": "Да, вот бе'лый, а вот чёрный.", "en": "Yes, here's white, and here's rye." },
      { "who": "a", "ru": "Чёрный, пожа'луйста. И литр молока'.", "en": "Rye, please. And a litre of milk." },
      { "who": "b", "ru": "Что ещё?", "en": "What else?" },
      { "who": "a", "ru": "Две'сти гра'ммов сы'ра, пожа'луйста.", "en": "Two hundred grams of cheese, please." },
      { "who": "b", "ru": "Пожа'луйста. Э'то всё?", "en": "Here you are. Is that all?" },
      { "who": "a", "ru": "Да. Ско'лько с меня'?", "en": "Yes. How much do I owe you?" },
      { "who": "b", "ru": "Три'ста пятьдеся'т рубле'й.", "en": "Three hundred and fifty roubles." },
      { "who": "a", "ru": "Мо'жно ка'ртой?", "en": "Can I pay by card?" },
      { "who": "b", "ru": "Коне'чно.", "en": "Of course." }
    ]
  },
  {
    "id": "metro", "en": "Asking the way to the metro", "th": "travel", "b": "A1", "you": "a",
    "roles": { "a": "You", "b": "Passerby" },
    "lines": [
      { "who": "a", "ru": "Извини'те, где здесь метро'?", "en": "Excuse me, where's the metro around here?" },
      { "who": "b", "ru": "Иди'те пря'мо, пото'м напра'во.", "en": "Go straight on, then right." },
      { "who": "a", "ru": "Э'то далеко'?", "en": "Is it far?" },
      { "who": "b", "ru": "Нет, мину'т пять пешко'м.", "en": "No, about five minutes on foot." },
      { "who": "a", "ru": "А как называ'ется ста'нция?", "en": "And what's the station called?" },
      { "who": "b", "ru": "«Пу'шкинская».", "en": "Pushkinskaya." },
      { "who": "a", "ru": "Большо'е спаси'бо!", "en": "Thank you very much!" },
      { "who": "b", "ru": "Не' за что.", "en": "Not at all." }
    ]
  },
  {
    "id": "taxi", "en": "Taking a taxi", "th": "travel", "b": "A2", "you": "a",
    "roles": { "a": "You", "b": "Driver" },
    "lines": [
      { "who": "b", "ru": "До'брый ве'чер! Куда' е'дем?", "en": "Good evening! Where are we going?" },
      { "who": "a", "ru": "В гости'ницу «Росси'я», пожа'луйста.", "en": "To the Rossiya hotel, please." },
      { "who": "b", "ru": "Хорошо'. Вы торо'питесь?", "en": "All right. Are you in a hurry?" },
      { "who": "a", "ru": "Да, немно'го. Ско'лько е'хать?", "en": "Yes, a little. How long is the drive?" },
      { "who": "b", "ru": "Мину'т два'дцать, е'сли не бу'дет про'бок.", "en": "About twenty minutes, if there's no traffic." },
      { "who": "a", "ru": "Мо'жно откры'ть окно'?", "en": "May I open the window?" },
      { "who": "b", "ru": "Коне'чно, открыва'йте.", "en": "Of course, go ahead." },
      { "who": "b", "ru": "Вот мы и прие'хали. С вас пятьсо'т рубле'й.", "en": "Here we are. That's five hundred roubles." },
      { "who": "a", "ru": "Вот, пожа'луйста. Сда'чи не на'до.", "en": "Here you are. Keep the change." },
      { "who": "b", "ru": "Спаси'бо! Всего' до'брого!", "en": "Thank you! All the best!" }
    ]
  },
  {
    "id": "hotel", "en": "Checking into a hotel", "th": "travel", "b": "A2", "you": "a",
    "roles": { "a": "You", "b": "Receptionist" },
    "lines": [
      { "who": "a", "ru": "Здра'вствуйте! Я заброни'ровал но'мер.", "en": "Hello! I booked a room. (a man speaking)" },
      { "who": "b", "ru": "До'брый день. Ва'ша фами'лия?", "en": "Good afternoon. Your surname?" },
      { "who": "a", "ru": "Смит. Джон Смит.", "en": "Smith. John Smith." },
      { "who": "b", "ru": "Да, вот. Одноме'стный но'мер на три но'чи.", "en": "Yes, here it is. A single room for three nights." },
      { "who": "a", "ru": "Всё пра'вильно.", "en": "That's right." },
      { "who": "b", "ru": "Ваш па'спорт, пожа'луйста.", "en": "Your passport, please." },
      { "who": "a", "ru": "Вот. Во ско'лько за'втрак?", "en": "Here it is. What time is breakfast?" },
      { "who": "b", "ru": "С семи' до десяти'.", "en": "From seven to ten." },
      { "who": "a", "ru": "А где лифт?", "en": "And where's the lift?" },
      { "who": "b", "ru": "Сле'ва. Вот ваш ключ, но'мер три'ста пять.", "en": "On the left. Here's your key, room three hundred and five." }
    ]
  },
  {
    "id": "pharmacy", "en": "At the pharmacy", "th": "feel", "b": "A2", "you": "a",
    "roles": { "a": "You", "b": "Pharmacist" },
    "lines": [
      { "who": "b", "ru": "Здра'вствуйте. Чем могу' помо'чь?", "en": "Hello. How can I help?" },
      { "who": "a", "ru": "У меня' боли'т голова'.", "en": "I have a headache." },
      { "who": "b", "ru": "Давно'?", "en": "For long?" },
      { "who": "a", "ru": "Со вчера'шнего дня.", "en": "Since yesterday." },
      { "who": "b", "ru": "Температу'ра есть?", "en": "Do you have a temperature?" },
      { "who": "a", "ru": "Нет, но я пло'хо сплю.", "en": "No, but I'm sleeping badly." },
      { "who": "b", "ru": "Вот, возьми'те ибупрофе'н.", "en": "Here, take some ibuprofen." },
      { "who": "a", "ru": "Как его' принима'ть?", "en": "How should I take it?" },
      { "who": "b", "ru": "Одну' табле'тку три ра'за в день.", "en": "One tablet three times a day." },
      { "who": "a", "ru": "Поня'тно. Спаси'бо!", "en": "I see. Thank you!" }
    ]
  },
  {
