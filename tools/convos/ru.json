    "lines": [
      { "who": "a", "ru": "Здра'вствуйте. Оди'н биле'т до Петербу'рга, пожа'луйста.", "en": "Hello. One ticket to St Petersburg, please." },
      { "who": "b", "ru": "На како'е число'?", "en": "For what date?" },
