      { "who": "a", "ru": "Отли'чно. Ско'лько сто'ит?", "en": "Great. How much is it?" },
      { "who": "b", "ru": "Четы'ре ты'сячи рубле'й.", "en": "Four thousand roubles." },
      { "who": "a", "ru": "Хорошо'. Мо'жно ме'сто у окна'?", "en": "Fine. Can I have a window seat?" },
      { "who": "b", "ru": "Да. Ваш па'спорт, пожа'луйста.", "en": "Yes. Your passport, please." },
      { "who": "a", "ru": "Вот, пожа'луйста.", "en": "Here you are." }
    ]
  },
  {
