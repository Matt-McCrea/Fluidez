    "n": "Friends, so ты.",
    "lines": [
      { "who": "b", "ru": "Алло'! Приве'т!", "en": "Hello? Hi!" },
      { "who": "a", "ru": "Приве'т, Ма'ша! Что де'лаешь в суббо'ту?", "en": "Hi, Masha! What are you doing on Saturday?" },
      { "who": "b", "ru": "Пока' ничего'. А что?", "en": "Nothing yet. Why?" },
      { "who": "a", "ru": "Пойдём в кино'?", "en": "Shall we go to the cinema?" },
      { "who": "b", "ru": "Дава'й! Во ско'лько?", "en": "Let's! What time?" },
      { "who": "a", "ru": "Фильм начина'ется в семь.", "en": "The film starts at seven." },
      { "who": "b", "ru": "Хорошо'. Где встре'тимся?", "en": "Okay. Where shall we meet?" },
      { "who": "a", "ru": "Дава'й у метро' «Арба'тская».", "en": "Let's meet at Arbatskaya metro." },
      { "who": "b", "ru": "Отли'чно. До суббо'ты!", "en": "Great. See you on Saturday!" },
      { "who": "a", "ru": "Пока'!", "en": "Bye!" }
    ]
  },
  {
    "id": "family", "en": "Talking about family", "th": "social", "b": "A2", "you": "a",
    "roles": { "a": "You", "b": "Dima" },
    "n": "Friends, so ты.",
    "lines": [
      { "who": "b", "ru": "У тебя' больша'я семья'?", "en": "Do you have a big family?" },
      { "who": "a", "ru": "Не о'чень. У меня' брат и сестра'.", "en": "Not very. I have a brother and a sister." },
      { "who": "b", "ru": "Они' ста'рше и'ли мла'дше?", "en": "Are they older or younger?" },
      { "who": "a", "ru": "Брат ста'рше, а сестра' мла'дше.", "en": "My brother is older, and my sister is younger." },
      { "who": "b", "ru": "А чем они' занима'ются?", "en": "And what do they do?" },
      { "who": "a", "ru": "Брат врач, а сестра' ещё у'чится.", "en": "My brother is a doctor, and my sister is still studying." },
      { "who": "b", "ru": "А роди'тели?", "en": "And your parents?" },
      { "who": "a", "ru": "Они' живу'т в Ло'ндоне. Па'па уже' на пе'нсии.", "en": "They live in London. Dad has already retired." },
      { "who": "b", "ru": "А у меня' то'лько мла'дший брат.", "en": "And I only have a younger brother." }
    ]
  },
  {
    "id": "home", "en": "Visiting a Russian home", "th": "food", "b": "B1", "you": "a",
    "roles": { "a": "You", "b": "Host" },
    "lines": [
      { "who": "b", "ru": "Проходи'те, пожа'луйста! Раздева'йтесь.", "en": "Come in, please! Take your coat off." },
      { "who": "a", "ru": "Спаси'бо. Э'то вам, к ча'ю.", "en": "Thank you. This is for you, to have with tea." },
      { "who": "b", "ru": "Ну заче'м же! Сади'тесь за стол.", "en": "Oh, you shouldn't have! Sit down at the table." },
      { "who": "a", "ru": "Как вку'сно па'хнет!", "en": "It smells so good!" },
      { "who": "b", "ru": "Угоща'йтесь. Вот борщ, вот пирожки' с капу'стой.", "en": "Help yourself. Here's borscht, and here are cabbage pies." },
      { "who": "a", "ru": "О'чень вку'сно! Вы са'ми пекли'?", "en": "Delicious! Did you bake them yourself?" },
      { "who": "b", "ru": "Коне'чно. Возьми'те ещё!", "en": "Of course. Have some more!" },
      { "who": "a", "ru": "Спаси'бо, я уже' нае'лся.", "en": "Thank you, I'm already full. (a man speaking)" },
      { "who": "b", "ru": "Тогда' дава'йте пить чай. Вам с са'харом?", "en": "Then let's have tea. Would you like sugar?" },
      { "who": "a", "ru": "Нет, без са'хара, но с варе'ньем.", "en": "No sugar, thanks, but some jam." }
    ]
  },
  {
    "id": "work", "en": "Small talk about work and hobbies", "th": "social", "b": "B1", "you": "a",
    "roles": { "a": "You", "b": "Sergei" },
    "lines": [
      { "who": "b", "ru": "А чем вы занима'етесь?", "en": "And what do you do?" },
      { "who": "a", "ru": "Я программи'ст, рабо'таю в небольшо'й компа'нии.", "en": "I'm a programmer, I work at a small company." },
      { "who": "b", "ru": "Нра'вится?", "en": "Do you like it?" },
      { "who": "a", "ru": "В це'лом да, но иногда' быва'ет ску'чно.", "en": "On the whole, yes, but sometimes it gets boring." },
      { "who": "b", "ru": "А что вы де'лаете в свобо'дное вре'мя?", "en": "And what do you do in your free time?" },
      { "who": "a", "ru": "Игра'ю на гита'ре и мно'го чита'ю.", "en": "I play the guitar and read a lot." },
      { "who": "b", "ru": "Здо'рово! А я давно' хочу' научи'ться игра'ть.", "en": "Great! I've wanted to learn to play for ages." },
      { "who": "a", "ru": "Е'сли хоти'те, могу' показа'ть па'ру акко'рдов.", "en": "If you like, I can show you a few chords." },
      { "who": "b", "ru": "С удово'льствием!", "en": "I'd love that!" },
      { "who": "a", "ru": "Тогда' дава'йте обменя'емся номера'ми.", "en": "Then let's swap numbers." }
    ]
  }
]
