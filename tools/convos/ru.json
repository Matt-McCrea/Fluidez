[
  {
    "id": "meet", "en": "Meeting someone new", "th": "intro", "b": "A1", "you": "a",
    "roles": { "a": "You", "b": "Olga" },
    "n": "New people, so вы.",
    "lines": [
      { "who": "a", "ru": "Здра'вствуйте! Меня' зову'т Марк.", "en": "Hello! My name is Mark." },
      { "who": "b", "ru": "О'чень прия'тно, Марк. Я О'льга.", "en": "Nice to meet you, Mark. I'm Olga." },
      { "who": "a", "ru": "Прия'тно познако'миться. Вы из Москвы'?", "en": "Nice to meet you. Are you from Moscow?" },
      { "who": "b", "ru": "Нет, я из Каза'ни. А вы отку'да?", "en": "No, I'm from Kazan. And where are you from?" },
      { "who": "a", "ru": "Я из А'нглии.", "en": "I'm from England." },
      { "who": "b", "ru": "Вы хорошо' говори'те по-ру'сски!", "en": "You speak Russian well!" },
      { "who": "a", "ru": "Спаси'бо, я то'лько учу'сь.", "en": "Thanks, I'm only just learning." },
      { "who": "b", "ru": "Молоде'ц! Добро' пожа'ловать!", "en": "Well done! Welcome!" }
    ]
  },
  {
    "id": "cafe", "en": "Ordering in a café", "th": "food", "b": "A1", "you": "a",
    "roles": { "a": "You", "b": "Waiter" },
    "lines": [
      { "who": "b", "ru": "Здра'вствуйте! Что бу'дете зака'зывать?", "en": "Hello! What would you like to order?" },
      { "who": "a", "ru": "Ча'шку ко'фе, пожа'луйста.", "en": "A cup of coffee, please." },
      { "who": "b", "ru": "С молоко'м?", "en": "With milk?" },
      { "who": "a", "ru": "Да, с молоко'м. И кусо'к то'рта.", "en": "Yes, with milk. And a piece of cake." },
      { "who": "b", "ru": "Есть медо'вый и шокола'дный.", "en": "There's honey cake and chocolate cake." },
      { "who": "a", "ru": "Шокола'дный, пожа'луйста.", "en": "The chocolate one, please." },
      { "who": "b", "ru": "Хорошо'. Что-то ещё?", "en": "All right. Anything else?" },
      { "who": "a", "ru": "Нет, спаси'бо. Э'то всё.", "en": "No, thanks. That's all." },
      { "who": "b", "ru": "Сейча'с принесу'.", "en": "I'll bring it right away." }
    ]
  },
  {
